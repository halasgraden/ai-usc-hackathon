                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Station"
          },
          "weeks": {
            "items": {
              "$ref": "#/components/schemas/TrendPoint"
            },
            "type": "array",
            "title": "Weeks"
          }
        },
        "type": "object",
        "required": [
