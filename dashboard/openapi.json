          "soup_stew",
          "mashed_puree",
          "beans_lentils",
          "poultry",
          "red_meat",
          "fish_seafood",
          "eggs",
          "tofu_plant_protein",
          "raw_vegetables",
          "cooked_vegetables",
          "leafy_salad",
