              }
            }
          }
        }
      }
    },
    "/menu/{day}": {
      "get": {
        "summary": "Menu For Day",
        "description": "The cleaned, categorized menu: what the camera may recognize that day.",
        "operationId": "menu_for_day_menu__day__get",
