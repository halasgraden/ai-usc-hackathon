  "components": {
    "schemas": {
      "Body_upload_plate_image_plates_image_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "description": "JPEG or PNG, plate seen from above"
          },
          "meal": {
            "type": "string",
            "minLength": 1,
            "title": "Meal"
          }
        },
        "type": "object",
        "required": [
          "image",
          "meal"
        ],
        "title": "Body_upload_plate_image_plates_image_post"
      },
      "DailyMenu": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "hall": {
            "type": "string",
            "title": "Hall"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "meals": {
            "items": {
              "$ref": "#/components/schemas/MealMenu"
            },
            "type": "array",
            "title": "Meals"
          }
        },
        "type": "object",
        "required": [
          "day",
          "hall",
          "source",
          "meals"
        ],
        "title": "DailyMenu",
        "description": "One hall's cleaned menu for one day. Only meals actually served are listed."
      },
      "DishDetailOut": {
        "properties": {
          "dish": {
            "$ref": "#/components/schemas/DishRow"
          },
          "data_source": {
            "type": "string",
            "enum": [
              "live",
              "seeded"
            ],
            "title": "Data Source"
          },
          "percent_left_samples": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Percent Left Samples",
            "description": "For the distribution chart"
          },
          "weekly": {
            "items": {
              "$ref": "#/components/schemas/TrendPoint"
            },
            "type": "array",
            "title": "Weekly"
          }
        },
        "type": "object",
        "required": [
          "dish",
          "data_source",
          "percent_left_samples",
          "weekly"
        ],
        "title": "DishDetailOut",
        "description": "``GET /dashboard/dishes/{dish_name}``."
      },
      "DishRow": {
        "properties": {
          "kg_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kg Low"
          },
          "kg_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kg High"
          },
          "serving_comparison": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ServingComparison"
              },
              {
                "type": "null"
              }
            ]
          },
          "dish_name": {
            "type": "string",
            "title": "Dish Name"
          },
          "station": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Station"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FoodCategory"
              },
              {
                "type": "null"
              }
            ]
          },
          "plates_seen": {
            "type": "integer",
            "title": "Plates Seen"
          },
          "total_kg": {
            "type": "number",
            "title": "Total Kg"
          },
          "mean_percent_left": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Percent Left"
          },
          "trend": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "flat",
              "unknown"
            ],
            "title": "Trend",
            "default": "unknown"
          },
          "mean_grams": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Grams"
          },
          "mean_grams_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Grams Low"
          },
          "mean_grams_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Grams High"
          },
          "previous_total_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Total Kg"
          },
          "previous_mean_percent_left": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Mean Percent Left"
          }
        },
        "type": "object",
        "required": [
          "dish_name",
          "plates_seen",
          "total_kg",
          "mean_percent_left"
        ],
        "title": "DishRow"
