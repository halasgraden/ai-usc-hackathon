{
  "name": "leftover-lens-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:types": "openapi-typescript openapi.json -o src/lib/api.generated.ts && prettier --write src/lib/api.generated.ts",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0"
  }
}
