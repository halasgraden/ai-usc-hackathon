# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Which hall this rig watches (slug used by the USC Hospitality menu API).
LEFTOVER_HALL=university-village
# SQLite for the hackathon; any SQLModel/SQLAlchemy URL works for a pilot.
LEFTOVER_DATABASE_URL=sqlite:///./leftover_lens.db
# Where fetched menus and the category cache are stored.
LEFTOVER_DATA_DIR=./data
# Shared secret the rig (and the phone /capture page) sends as a Bearer token
# to POST /plates. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEFTOVER_DEVICE_TOKEN=
# Camera source for capture/: a device index ("0") or a stream URL
# (e.g. the IP Webcam app's http://<phone-ip>:8080/video).
LEFTOVER_CAMERA_SOURCE=0
