# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Which hall this rig watches (slug used by the USC Hospitality menu API).
LEFTOVER_HALL=university-village
# SQLite for the hackathon; any SQLModel/SQLAlchemy URL works for a pilot.
LEFTOVER_DATABASE_URL=sqlite:///./leftover_lens.db
# Where fetched menus and the category cache are stored.
LEFTOVER_DATA_DIR=./data
# Shared secret the rig (and the phone /capture page) sends as a Bearer token
# to POST /plates. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEFTOVER_DEVICE_TOKEN=
# Camera source for capture/: a device index ("0") or a stream URL
# (e.g. the IP Webcam app's http://<phone-ip>:8080/video).
LEFTOVER_CAMERA_SOURCE=0
# Bearer token the dashboard sends to /dashboard/* (staff only). Same generator as above.
LEFTOVER_STAFF_TOKEN=
# Browser origins allowed to call the API (comma-separated).
LEFTOVER_CORS_ORIGINS=http://localhost:3000
# Hall-local time zone; plates are bucketed into days and meals in this zone.
LEFTOVER_TIMEZONE=America/Los_Angeles
# Cost and CO2e factors. PLACEHOLDERS, not USC figures: replace with sourced numbers
# before showing them to anyone. Every response that uses them carries an assumptions map.
LEFTOVER_COST_USD_PER_KG=4.00
LEFTOVER_CO2E_KG_PER_KG=2.50
# Segmentation model for POST /plates/image (exported by colab_train_village.ipynb).
LEFTOVER_SEG_MODEL=./models/village-v2.onnx
# YuNet face-guard weights (see models/FACE_MODEL.md). Missing = every frame dropped (fail closed).
LEFTOVER_FACE_MODEL=./models/face_detection_yunet_2023mar.onnx
# Where the rig loop (python -m capture) posts plates.
LEFTOVER_API_URL=http://127.0.0.1:8000
